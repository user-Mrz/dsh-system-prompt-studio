{
  "name": "@user-mrz/dsh-system-prompt-studio",
  "displayName": "System prompt studio",
  "description": "Per-conversation system prompt control for DeepSeek Harness: append a section, shadow-replace one named section, or replace the whole prompt. Applies on the next model request, persists per session, and inherits along fork lineage.",
  "version": "0.1.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-0 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "prepare": "node scripts/verify-entry.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node test/host-check.mjs && node test/client-check.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt-engineering"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "user-Mrz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-Mrz/dsh-system-prompt-studio.git"
  },
  "homepage": "https://github.com/user-Mrz/dsh-system-prompt-studio#readme",
  "bugs": {
    "url": "https://github.com/user-Mrz/dsh-system-prompt-studio/issues"
  }
}
